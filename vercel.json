{
    "version": 2,
    "rewrites": [
        {
            "source": "/sw.js",
            "destination": "/server.js"
        },
        {
            "source": "/api/(.*)",
            "destination": "/server.js"
        },
        {
            "source": "/uploads/(.*)",
            "destination": "/server.js"
        }
    ]
}